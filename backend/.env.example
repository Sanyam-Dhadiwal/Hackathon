# ==============================================================================
# Adaptive AI Travel Planner - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Free Google Gemini API Key (Optional)
# ------------------------------------------------------------------------------
# Get your free key in 30 seconds with any personal Google account (NO credit card needed):
# Link: https://aistudio.google.com/app/apikey
#
# If left empty, the application uses the built-in Curated Travel Intelligence Engine
# so the hackathon demo runs smoothly with zero external dependencies!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# 2. MongoDB Atlas Cloud Database (Optional)
# ------------------------------------------------------------------------------
# Create a free M0 Sandbox cluster (512MB permanently free, no credit card):
# Link: https://www.mongodb.com/atlas/database
#
# Example connection string:
# MONGODB_URI=mongodb+srv://travel_user:YourStrongPassword@cluster0.abcde.mongodb.net/travel_planner?retryWrites=true&w=majority
#
# If left empty or offline, the app automatically uses the resilient In-Memory MongoDB
# store (mongomock), guaranteeing the demo NEVER crashes if network drops!
MONGODB_URI=
DATABASE_NAME=travel_planner

# ------------------------------------------------------------------------------
# 3. Server Networking Settings
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 4. JWT Authentication Settings
# ------------------------------------------------------------------------------
# Generate strong, distinct secrets for production (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 5. Email Verification Settings
# ------------------------------------------------------------------------------
# Verification token lifetime (default: 30 minutes)
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
# Cooldown between resend requests per email (default: 60 seconds)
EMAIL_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 6. SMTP Email Configuration
# ------------------------------------------------------------------------------
# Leave EMAIL_HOST blank in development — the backend will print the
# verification URL to the console prefixed with [DEV EMAIL] so you can
# test the full flow without setting up a mail server.
#
# Production examples:
#   Gmail SMTP:   host=smtp.gmail.com  port=587  tls=true
#   Mailgun SMTP: host=smtp.mailgun.org port=587  tls=true
#   SendGrid:     host=smtp.sendgrid.net port=587  user=apikey  password=<API_KEY>
#   AWS SES SMTP: host=email-smtp.<region>.amazonaws.com port=587 tls=true
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@travelplanner.app
EMAIL_USE_TLS=true

# ------------------------------------------------------------------------------
# 7. Frontend URL (used in email verification links)
# ------------------------------------------------------------------------------
# Development default: http://localhost:5173
# Production: https://your-deployed-frontend.com
FRONTEND_URL=http://localhost:5173
