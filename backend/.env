# ==============================================================================
# Adaptive AI Travel Planner - Local Environment File
# ==============================================================================

# 1. Google Gemini API Key (Free tier from https://aistudio.google.com/app/apikey)
# Leave blank to use the built-in deterministic Curated Intelligence Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. MongoDB Atlas Connection String (Free M0 cluster from https://www.mongodb.com/atlas)
# Leave blank to use the built-in zero-setup In-Memory MongoDB engine.
MONGODB_URI=
DATABASE_NAME=travel_planner

# 3. Server Networking
HOST=127.0.0.1
PORT=8000

# 4. JWT Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_ai_travel_planner_2026_secure
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_ai_travel_planner_2026_secure
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# 5. Email Verification
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
EMAIL_RESEND_COOLDOWN_SECONDS=60

# 6. SMTP Email — leave EMAIL_HOST blank to use console-log fallback in development
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@travelplanner.app
EMAIL_USE_TLS=true

# 7. Frontend URL (for verification links in emails)
FRONTEND_URL=http://localhost:5173
